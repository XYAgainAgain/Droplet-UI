{
  "name": "jelly-ui",
  "version": "1.1.0",
  "description": "A dependency-free Web Components library for soft, tactile product interfaces — real form controls meet soft-body physics.",
  "type": "module",
  "license": "MIT",
  "author": "Baldvin Mar Smarason <bmson@bmson.com>",
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild": true,
    "rs-module-lexer": true
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "ui",
    "design-system",
    "canvas",
    "soft-body"
  ],
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "main": "./dist/jelly.js",
  "module": "./dist/jelly.js",
  "types": "./dist/jelly.d.ts",
  "exports": {
    ".": {
      "types": "./dist/jelly.d.ts",
      "import": "./dist/jelly.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite build --watch",
    "serve": "node server.mjs",
    "build": "vite build",
    "build:site": "node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:scripts && npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:scripts": "node --test scripts/docs-drift.test.mjs scripts/import-purity.test.mjs",
    "test:chromium": "vitest run --browser.name=chromium",
    "test:firefox": "vitest run --browser.name=firefox",
    "test:webkit": "vitest run --browser.name=webkit",
    "test:watch": "vitest",
    "docs:manifest": "cem analyze",
    "docs:data": "node scripts/build-docs-data.mjs",
    "docs": "npm run docs:manifest && npm run docs:data",
    "prepublishOnly": "npm run build && npm run docs:manifest"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^26.4.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "esbuild": "^0.28.2",
    "lottie-web": "^5.13.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "customElements": "custom-elements.json"
}

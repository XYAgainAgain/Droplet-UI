{
  "name": "droplet-ui",
  "version": "0.1.0",
  "description": "A dependency-free Web Components library for soft, tactile interfaces, with real form controls riding soft-body physics. A drop-in fork of Jelly UI.",
  "type": "module",
  "license": "MIT",
  "author": "XYAgainAgain",
  "contributors": [
    "Baldvin Mar Smarason <bmson@bmson.com> (https://github.com/bmson)"
  ],
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild": true,
    "rs-module-lexer": true
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "ui",
    "design-system",
    "canvas",
    "soft-body"
  ],
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "main": "./dist/droplet.js",
  "module": "./dist/droplet.js",
  "types": "./dist/droplet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/droplet.d.ts",
      "import": "./dist/esm/droplet.js",
      "default": "./dist/esm/droplet.js"
    },
    "./core": {
      "types": "./dist/esm/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "default": "./dist/esm/core/index.js"
    },
    "./register": {
      "types": "./dist/esm/register.d.ts",
      "import": "./dist/esm/register.js",
      "default": "./dist/esm/register.js"
    },
    "./compat": {
      "types": "./dist/esm/compat/index.d.ts",
      "import": "./dist/esm/compat/index.js",
      "default": "./dist/esm/compat/index.js"
    },
    "./dist/droplet.js": {
      "types": "./dist/esm/droplet.d.ts",
      "import": "./dist/esm/droplet.js",
      "default": "./dist/esm/droplet.js"
    },
    "./dist/jelly.js": {
      "types": "./dist/esm/droplet.d.ts",
      "import": "./dist/esm/droplet.js",
      "default": "./dist/esm/droplet.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json",
    "./*": {
      "types": "./dist/esm/components/*/index.d.ts",
      "import": "./dist/esm/components/*/index.js",
      "default": "./dist/esm/components/*/index.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "serve": "node server.mjs",
    "build": "vite build && vite build -c vite.esm.config.ts && tsc -p tsconfig.build.json",
    "build:site": "node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:scripts && npm run test:chromium && npm run test:firefox && npm run test:webkit",
    "test:scripts": "npm run build && npm run docs && node --test scripts/docs-drift.test.mjs scripts/import-purity.test.mjs scripts/docs-integrity.test.mjs scripts/package-smoke.test.mjs",
    "test:chromium": "vitest run --browser.name=chromium",
    "test:firefox": "vitest run --browser.name=firefox",
    "test:webkit": "vitest run --browser.name=webkit",
    "test:watch": "vitest",
    "docs:manifest": "cem analyze",
    "docs:data": "node scripts/build-docs-data.mjs",
    "docs": "npm run docs:manifest && npm run docs:data",
    "prepublishOnly": "npm run build && npm run docs:manifest"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "^26.4.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "esbuild": "^0.28.2",
    "lottie-web": "^5.13.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "customElements": "custom-elements.json"
}
